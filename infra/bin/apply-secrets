#!/usr/bin/env bash
set -euo pipefail

namespace="${1:-rocket-sense}"
repo_root="$(git rev-parse --show-toplevel)"
secrets_dir="$repo_root/infra/secrets"
tmp_file="$(mktemp)"

cleanup() {
  rm -f "$tmp_file"
}
trap cleanup EXIT

(
  cd "$secrets_dir"
  RULES=./secrets.nix agenix -d rocket-sense.env.age
) > "$tmp_file"

kubectl create namespace "$namespace" --dry-run=client -o yaml | kubectl apply -f -
kubectl -n "$namespace" create secret generic rocket-sense-secrets \
  --from-env-file="$tmp_file" \
  --dry-run=client \
  -o yaml | kubectl apply -f -
