#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
subtr_actor_dir="$repo_root/vendor/subtr-actor"
static_dir="$repo_root/crates/rocket-sense-server/static/subtr-actor"
rev="${1:-${SUBTR_ACTOR_REV:-}}"

if [[ ! -d "$subtr_actor_dir/.git" && ! -f "$subtr_actor_dir/.git" ]]; then
  git -C "$repo_root" submodule update --init vendor/subtr-actor
fi

if [[ -n "$rev" ]]; then
  git -C "$subtr_actor_dir" fetch origin "$rev"
  git -C "$subtr_actor_dir" checkout --detach FETCH_HEAD
fi

resolved_rev="$(git -C "$subtr_actor_dir" rev-parse HEAD)"
echo "Using subtr-actor $resolved_rev"

# Mirror subtr-actor's [patch.crates-io] section into the workspace root
# Cargo.toml. Cargo only honors [patch] at the workspace root, so vendored
# subtr-actor's own patches (e.g. a forked boxcars rev) have no effect on this
# workspace unless copied here. Keeping the copy mechanical makes subtr-actor
# the single place that controls patched crate revisions.
sync_crates_io_patch() {
  local source_manifest="$subtr_actor_dir/Cargo.toml"
  local target_manifest="$repo_root/Cargo.toml"
  local begin_marker='# --- BEGIN synced [patch.crates-io] (managed by scripts/sync-subtr-actor) ---'
  local end_marker='# --- END synced [patch.crates-io] ---'

  # Extract the [patch.crates-io] section (preceding comment block included,
  # body up to the next section header). $(...) trims trailing blank lines.
  local patch_block
  patch_block="$(awk '
    in_section {
      if (/^\[/) exit
      print
      next
    }
    /^#/ { buf = buf $0 "\n"; next }
    /^\[patch\.crates-io\]$/ { printf "%s", buf; print; in_section = 1; next }
    { buf = "" }
  ' "$source_manifest")"

  # Drop any existing synced region, then re-append it at EOF.
  local stripped
  stripped="$(awk -v begin="$begin_marker" -v end="$end_marker" '
    $0 == begin { skipping = 1; next }
    skipping { if ($0 == end) skipping = 0; next }
    { print }
  ' "$target_manifest")"

  {
    printf '%s\n\n' "$stripped"
    printf '%s\n' "$begin_marker"
    printf '%s\n' '# Copied verbatim from vendor/subtr-actor/Cargo.toml so that subtr-actor is'
    printf '%s\n' '# the single place that controls patched crate revisions (e.g. boxcars).'
    printf '%s\n' '# Cargo only honors [patch] at the workspace root, hence the copy. Do not'
    printf '%s\n' '# edit by hand; run scripts/sync-subtr-actor instead.'
    if [[ -n "$patch_block" ]]; then
      printf '%s\n' "$patch_block"
    fi
    printf '%s\n' "$end_marker"
  } > "$target_manifest.tmp"
  mv "$target_manifest.tmp" "$target_manifest"
}

sync_crates_io_patch

# Re-resolves the workspace, applying any [patch.crates-io] changes synced
# above in addition to picking up the new subtr-actor rev.
cargo update -p subtr-actor
nix flake update subtr-actor-src

asset_result="$repo_root/result-subtr-actor-static"
nix build "path:$subtr_actor_dir#js-stats-player-pages" --out-link "$asset_result"

sync_dist() {
  local source_dir="$1"
  local target_dir="$2"
  if [[ -e "$target_dir" ]]; then
    chmod -R u+w "$target_dir"
  fi
  rm -rf "$target_dir"
  mkdir -p "$target_dir"
  cp -R "$source_dir"/. "$target_dir"/
  chmod -R u+w "$target_dir"
}

sync_dist "$asset_result" "$static_dir"
rm "$asset_result"

# Vendor the publishable npm package layouts for @rlrml/subtr-actor,
# @rlrml/player, and @rlrml/viewer into web/vendor so the web app's `file:` deps always resolve
# to wasm/JS built from this exact submodule rev (never a stale registry
# tarball). The flake outputs are byte-for-byte what `npm publish` ships.
web_vendor_dir="$repo_root/web/vendor/@rlrml"
wasm_pkg_result="$repo_root/result-subtr-actor-wasm-pkg"
player_pkg_result="$repo_root/result-subtr-actor-player-pkg"
viewer_pkg_result="$repo_root/result-subtr-actor-viewer-pkg"

nix build "path:$subtr_actor_dir#js-wasm-pkg" --out-link "$wasm_pkg_result"
nix build "path:$subtr_actor_dir#js-player-pkg" --out-link "$player_pkg_result"
nix build "path:$subtr_actor_dir#js-viewer-pkg" --out-link "$viewer_pkg_result"

sync_dist "$wasm_pkg_result" "$web_vendor_dir/subtr-actor"
sync_dist "$player_pkg_result" "$web_vendor_dir/player"
sync_dist "$viewer_pkg_result" "$web_vendor_dir/viewer"
rm "$wasm_pkg_result" "$player_pkg_result" "$viewer_pkg_result"

# Rev markers let the guard test (vendored_subtr_actor_sync) verify the
# committed artifacts match the committed submodule gitlink. Written after the
# sync_dist calls because those rm -rf their target directories.
printf '%s\n' "$resolved_rev" > "$web_vendor_dir/.subtr-actor-rev"
printf '%s\n' "$resolved_rev" > "$static_dir/.subtr-actor-rev"

# Refresh package-lock.json/node_modules for the vendored file: deps.
(cd "$repo_root/web" && npm install)

git -C "$repo_root" add -f \
  .gitmodules Cargo.toml Cargo.lock flake.lock vendor/subtr-actor \
  "$repo_root/web/package.json" "$repo_root/web/package-lock.json"
# The built web vendor packages and static player assets are NOT committed
# (generated from the submodule flake — see their .gitignores). Only the
# package.json manifests + .subtr-actor-rev markers are tracked, so a plain add
# (gitignore honored) stages exactly those.
git -C "$repo_root" add "$repo_root/web/vendor" "$static_dir"
echo "Synced subtr-actor assets from $resolved_rev"
