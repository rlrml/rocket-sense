#!/usr/bin/env bash
# Ensure the generated @rlrml/* packages exist under web/vendor for local dev
# and non-Nix CI. The packages are NOT committed (only their package.json
# manifests + a .subtr-actor-rev marker are); they're built from the
# vendor/subtr-actor submodule flake on demand.
#
# Idempotent: if the vendored packages already match the pinned submodule rev
# this is a fast no-op. Only rebuilds when missing or stale. If the work is
# needed but nix is unavailable, it fails loudly rather than leaving a
# half-populated tree (run `just sync-subtr-actor` in that case).
#
# The Nix web build does NOT use this script; rocketSenseWeb (flake.nix) pulls
# the packages straight from the submodule flake outputs. Do not wire this into
# an npm `prebuild` hook — that would fire inside the Nix sandbox.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
subtr_actor_dir="$repo_root/vendor/subtr-actor"
web_vendor_dir="$repo_root/web/vendor/@rlrml"
marker="$web_vendor_dir/.subtr-actor-rev"
# Any one built file is enough to tell "populated" from "manifest-only".
sentinel="$web_vendor_dir/subtr-actor/rl_replay_subtr_actor_bg.wasm"

# Pinned rev = the committed submodule gitlink (source of truth). Fall back to
# the submodule's checked-out HEAD if the gitlink can't be read.
expected_rev="$(git -C "$repo_root" rev-parse :vendor/subtr-actor 2>/dev/null \
  || git -C "$subtr_actor_dir" rev-parse HEAD 2>/dev/null || true)"

# Fast path: already built for this rev.
if [[ -f "$sentinel" && -f "$marker" && -n "$expected_rev" \
      && "$(cat "$marker")" == "$expected_rev" ]]; then
  exit 0
fi

if ! command -v nix >/dev/null 2>&1; then
  echo "ensure-subtr-vendor: web/vendor/@rlrml is missing or stale, and nix is not available." >&2
  echo "  Install nix, or run 'just sync-subtr-actor' to populate the @rlrml packages." >&2
  exit 1
fi

if [[ ! -e "$subtr_actor_dir/.git" ]]; then
  git -C "$repo_root" submodule update --init vendor/subtr-actor
fi

echo "ensure-subtr-vendor: building @rlrml packages from vendor/subtr-actor@${expected_rev:0:12} ..."

build_pkg() {
  # build_pkg <flake-attr> <dest-dir>
  local attr="$1" dest="$2" out
  out="$(nix build "path:$subtr_actor_dir#$attr" --no-link --print-out-paths)"
  rm -rf "$dest"
  mkdir -p "$dest"
  cp -R "$out"/. "$dest"/
  chmod -R u+w "$dest"
}

build_pkg js-wasm-pkg   "$web_vendor_dir/subtr-actor"
build_pkg js-player-pkg "$web_vendor_dir/player"
build_pkg js-viewer-pkg "$web_vendor_dir/viewer"

printf '%s\n' "$expected_rev" > "$marker"
echo "ensure-subtr-vendor: web/vendor/@rlrml ready."
