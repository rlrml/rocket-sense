{
  "name": "rocket-sense-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "vendor": "../scripts/ensure-subtr-vendor",
    "predev": "npm run vendor",
    "dev": "vite --host 127.0.0.1",
    "predev:lan": "npm run vendor",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,css,html,md}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "check:style": "npm run format:check && npm run lint"
  },
  "dependencies": {
    "@rlrml/viewer": "file:vendor/@rlrml/viewer",
    "camera-controls": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.8.1",
    "simple-icons": "^16.23.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16"
  }
}
